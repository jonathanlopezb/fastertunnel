# ─────────────────────────────────────────────────────────────────────────────
#  fasterTunnel API — Variables de Entorno
#  Copia este archivo como .env y configura los valores reales.
#  NUNCA hagas commit del archivo .env (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Puerto HTTP del servidor
PORT=8080

# URL de conexión a PostgreSQL
# Formato: postgresql://user:password@host:port/database?sslmode=disable
DATABASE_URL=postgresql://fastertunnel:fastertunnel123@localhost:5432/fastertunnel?sslmode=disable

# Clave secreta para firmar JWTs — usa una cadena larga y aleatoria en producción
# Genera una con: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production-fastertunnel

# Tiempo de expiración del token en horas (default: 24)
JWT_EXPIRY=24

# Entorno de ejecución: "development" o "production"
ENV=development

# Configuración del gateway WireGuard (no son claves privadas)
WIREGUARD_ENDPOINT=3.142.187.253:51820
WIREGUARD_SERVER_PUBLIC_KEY=xxVNhcOpa6Xty5MWtuI/iLDpSs16F5/tjOn7jA0jN2I=
WIREGUARD_AGENT_TOKEN=replace-with-a-random-token-of-at-least-32-characters
